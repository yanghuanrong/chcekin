# 掘金登录 Cookie（浏览器 DevTools → Application → Cookies → juejin.cn + api.juejin.cn）
# 建议包含 sessionid / sid_guard / csrf_session_id 等
JUEJIN_COOKIE=sessionid=xxx; sessionid_ss=xxx; sid_tt=xxx; uid_tt=xxx; sid_guard=xxx; csrf_session_id=xxx

# 可选：web_id / uuid（一般可从 Cookie 里的 __tea_cookie_tokens_2608 自动解析）
# JUEJIN_UUID=

# 钉钉机器人 Webhook
DINGTALK_WEBHOOK=https://oapi.dingtalk.com/robot/send?access_token=xxx

# 可选：钉钉加签密钥
DINGTALK_SECRET=

# 是否尝试免费抽奖（默认 true）
ENABLE_LOTTERY=true

# 签到/抽奖写接口被风控时会自动用 Playwright；本地默认 channel=chrome（需安装 Google Chrome）
# CI 环境会用 Playwright Chromium
# FORCE_BROWSER=true
# PLAYWRIGHT_CHANNEL=chrome
# PLAYWRIGHT_HEADLESS=true
